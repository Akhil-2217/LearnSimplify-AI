# IBM watsonx.ai credentials — copy this file to .env and fill in your API key.
# NEVER commit the real .env file to Git (.gitignore already protects it).
#
# How to set up:
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Then open .env and fill in WATSONX_API_KEY.

# Your IBM Cloud API key — keep this secret, never share it
WATSONX_API_KEY=

# IBM watsonx project ID (pre-filled for this project)
WATSONX_PROJECT_ID=81290637-28b4-4a3d-bbc1-5c1040e15482

# watsonx.ai base URL
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model ID
WATSONX_MODEL_ID=ibm/granite-4-h-small
